# Copy to .env. Every setting has a safe local default; this file documents them.

# --- Database / queue (used by docker compose) ---
POSTGRES_USER=rolematch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rolematch
# For running the backend outside Docker:
ROLEMATCH_DATABASE_URL=postgresql+psycopg://rolematch:change-me@localhost:5432/rolematch
ROLEMATCH_REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Set to true whenever the site is served over HTTPS (required in production).
ROLEMATCH_COOKIE_SECURE=false
ROLEMATCH_ALLOW_REGISTRATION=true
ROLEMATCH_CORS_ORIGINS=["http://localhost:3000"]

# --- Job sources ---
# Identify yourself to employer job boards.
ROLEMATCH_USER_AGENT=RoleMatch/0.1 (personal job-search tool; contact: you@example.com)
ROLEMATCH_HTTP_MIN_INTERVAL_SECONDS=1.0
ROLEMATCH_STALE_AFTER_HOURS=72
ROLEMATCH_CLOSE_AFTER_CONSECUTIVE_MISSES=2

# --- Embeddings ---
# minilm (default; needs models/all-MiniLM-L6-v2, see backend/scripts/fetch_model.py) or hashing (tests only, not semantic)
ROLEMATCH_EMBEDDING_BACKEND=minilm
# ROLEMATCH_EMBEDDING_MODEL_DIR=/absolute/path/to/models/all-MiniLM-L6-v2

# --- Optional external LLM (off unless configured here AND enabled by the user in Settings) ---
ROLEMATCH_LLM_PROVIDER=none
ROLEMATCH_LLM_API_KEY=
ROLEMATCH_LLM_MODEL=

# --- Frontend ---
ROLEMATCH_BACKEND_URL=http://localhost:8000
